# Django core
DJANGO_SECRET_KEY=replace-with-a-50-char-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Tracy Arm 2025 paper embargo (ISO 8601 with offset)
TRACYARM_EMBARGO_LIFT=2026-05-06T08:00:00-04:00
TRACYARM_YOUTUBE_URL=

# Pre-launch preview password for /inventory/* — leave empty post-launch.
# Logged-in users (any auth) bypass the barrier.
INVENTORY_PREVIEW_PASSWORD=

# tethys_db (PostGIS) — read-only access for the inventory map.
# Production: copy from /opt/monitoring/.env on the droplet.
# Local dev: copy from /Users/Hig/Docker/tethys-timescale-grafana/.env (host=tethys_db works
#   if the local landslidescience-web container joins tethys-timescale-grafana_internal).
TETHYS_DB_HOST=tethys_db
TETHYS_DB_PORT=5432
LANDSLIDE_DB_NAME=landslides
TETHYS_DB_USERNAME=tethys
TETHYS_DB_PASSWORD=

# Umami analytics (self-hosted; see CLAUDE.md "Traffic analytics").
# Leave UMAMI_WEBSITE_ID empty to switch analytics off entirely — the
# templates then emit no tracker tag at all, which is the right default for
# a clone that isn't running the analytics container.
#   UMAMI_DB_PASSWORD  password for the `umami` role in tethys_db
#   UMAMI_APP_SECRET   openssl rand -hex 32
#   UMAMI_WEBSITE_ID   uuid returned by POST /api/websites after first start
#   UMAMI_PUBLIC_URL   where a human reads the dashboard; blank hides the link
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
UMAMI_WEBSITE_ID=
#   UMAMI_TEAM_WEBSITE_ID  second site record; signed-in collaborators report
#                          here so they never mix into the public numbers
UMAMI_TEAM_WEBSITE_ID=
UMAMI_PUBLIC_URL=
#   UMAMI_BRIDGE_*     the view-only Umami account /traffic/ signs in as, so
#                      nobody needs a separate analytics password
UMAMI_BRIDGE_USER=
UMAMI_BRIDGE_PASSWORD=
